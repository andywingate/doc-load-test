# Copy this file to .env and fill in your values
# Then load with: Get-Content .env | ForEach-Object { if ($_ -match '^\s*([^#]\S+?)\s*=\s*(.+)') { [System.Environment]::SetEnvironmentVariable($Matches[1], $Matches[2]) } }

# Standard configuration (all modes)
BC_TENANT_ID=your-tenant-id-here
BC_CLIENT_ID=your-client-id-here
BC_CLIENT_SECRET=your-client-secret-here
BC_ENVIRONMENT=Production
BC_COMPANY=your-company-name-here

# Sprint Mode: Separate apps for SO and PO (optional, for maximum throughput)
# Create two separate Entra apps with the same BC API permissions
# This doubles your rate limit capacity and enables true parallel SO/PO creation
BC_CLIENT_ID_SO=your-so-app-client-id-here
BC_CLIENT_SECRET_SO=your-so-app-secret-here
BC_CLIENT_ID_PO=your-po-app-client-id-here
BC_CLIENT_SECRET_PO=your-po-app-secret-here
